NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=info

DATABASE_URL=<DATABASE_URL>

# Dedicated bearer credential for the private operational metrics endpoint.
# Leave unset to keep /ops/metrics unavailable.
OPS_METRICS_TOKEN=<HIGH_ENTROPY_DEDICATED_OPS_TOKEN>

# Durable inbound -> AI Engine processor. Keep disabled until the WordPress bridge,
# database migrations, credentials, and controlled rollout checks have passed.
PROCESSOR_ENABLED=false
# Required when PROCESSOR_ENABLED=true in production. Events received before this
# timestamp are permanently acknowledged without invoking AI or creating actions.
# PROCESSOR_CUTOVER_AT=2026-09-30T09:30:00.000Z
# Optional comma-separated SHA-256 conversation partition keys. When non-empty,
# only these partitions are processed; all other claimed events are permanently
# acknowledged with no AI call/action. Leave empty only for full rollout.
PROCESSOR_CANARY_PARTITION_KEYS=
WORDPRESS_AI_BRIDGE_URL=https://www.ishinaillab.com/wp-json/ishi-ai/v1
ISHI_AI_BRIDGE_TOKEN=<HIGH_ENTROPY_DEDICATED_BRIDGE_TOKEN>
AI_BRIDGE_TIMEOUT_MS=90000
AI_FILE_TTL_SECONDS=3600
MEDIA_MAX_BYTES=26214400
MEDIA_REQUEST_TIMEOUT_MS=15000

META_APP_ID=1042452472116584
META_APP_SECRET=<META_APP_SECRET>
META_WEBHOOK_VERIFY_TOKEN=<META_WEBHOOK_VERIFY_TOKEN>
META_GRAPH_API_VERSION=v26.0

# Provider-neutral action dispatcher. Deliberately disabled by default.
ACTION_DISPATCH_ENABLED=false
# Deprecated compatibility alias. Prefer ACTION_DISPATCH_ENABLED.
META_OUTBOUND_ENABLED=false
META_MESSENGER_ACCESS_TOKEN=<META_MESSENGER_PAGE_ACCESS_TOKEN>
META_INSTAGRAM_ACCESS_TOKEN=<META_INSTAGRAM_ACCESS_TOKEN>
META_WHATSAPP_ACCESS_TOKEN=<WHATSAPP_SYSTEM_USER_ACCESS_TOKEN>
META_INSTAGRAM_GRAPH_HOST=graph.instagram.com
META_OUTBOUND_REQUEST_TIMEOUT_MS=10000

# Instagram API with Instagram Login. These are the product-specific Instagram
# App ID and App Secret from Instagram > API setup with Instagram login; they
# are distinct from the general Meta app credentials above. Configure all three
# settings together to enable the public review login/callback flow. Tokens are
# encrypted in PostgreSQL with OAUTH_CREDENTIAL_ENCRYPTION_KEY_B64.
META_INSTAGRAM_OAUTH_APP_ID=<INSTAGRAM_PRODUCT_APP_ID>
META_INSTAGRAM_OAUTH_APP_SECRET=<INSTAGRAM_PRODUCT_APP_SECRET>
META_INSTAGRAM_OAUTH_REDIRECT_URI=https://apps.ishinaillab.com/ishikeit/oauth/instagram/callback/
META_INSTAGRAM_OAUTH_STATE_TTL_SECONDS=600
# Refresh long-lived Instagram tokens during the final 7 days before expiry.
META_INSTAGRAM_TOKEN_REFRESH_SKEW_SECONDS=604800
META_INSTAGRAM_OAUTH_REQUEST_TIMEOUT_MS=10000

# Telegram Bot API. Configure both values together. The webhook route and
# Telegram adapters stay unavailable when these are unset.
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=<HIGH_ENTROPY_TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_OUTBOUND_REQUEST_TIMEOUT_MS=10000

# TikTok API for Business shared developer-app identity. Business Messaging
# account-holder OAuth and Marketing advertiser OAuth reuse this same app ID/secret.
TIKTOK_BUSINESS_APP_ID=<TIKTOK_BUSINESS_APP_ID>
TIKTOK_BUSINESS_APP_SECRET=<TIKTOK_BUSINESS_APP_SECRET>

# TikTok for Business — Business Messaging account-holder OAuth.
# Configure both URLs together when the messaging authorization flow is enabled.
TIKTOK_BUSINESS_AUTHORIZATION_URL=<TIKTOK_GENERATED_ACCOUNT_HOLDER_AUTHORIZATION_URL>
TIKTOK_BUSINESS_REDIRECT_URI=https://apps.ishinaillab.com/ishikeit/oauth/tiktok/callback/
TIKTOK_BUSINESS_WEBHOOK_CALLBACK_URL=https://apps.ishinaillab.com/ishikeit/webhooks/tiktok

# TikTok Marketing API — advertiser OAuth. Configure both URLs together.
# The authorization URL is generated by TikTok for advertiser authorization.
# This flow reuses TIKTOK_BUSINESS_APP_ID/TIKTOK_BUSINESS_APP_SECRET above.
TIKTOK_MARKETING_AUTHORIZATION_URL=<TIKTOK_GENERATED_ADVERTISER_AUTHORIZATION_URL>
TIKTOK_MARKETING_REDIRECT_URI=https://apps.ishinaillab.com/ishikeit/oauth/tiktok/advertiser/callback/
# 32 random bytes encoded as base64; used only for application-level AES-256-GCM
# encryption of OAuth access/refresh tokens stored in PostgreSQL.
OAUTH_CREDENTIAL_ENCRYPTION_KEY_B64=<BASE64_32_BYTE_KEY>
# Set after the first successful authorization using the returned open_id.
# This activates the TikTok webhook, sender, and media resolver for that account.
TIKTOK_BUSINESS_ID=<TIKTOK_BUSINESS_ACCOUNT_OPEN_ID>
TIKTOK_BUSINESS_API_VERSION=v1.3
TIKTOK_WEBHOOK_MAX_AGE_SECONDS=300
TIKTOK_OAUTH_STATE_TTL_SECONDS=600
TIKTOK_TOKEN_REFRESH_SKEW_SECONDS=300
TIKTOK_OAUTH_REQUEST_TIMEOUT_MS=10000
TIKTOK_MARKETING_OAUTH_STATE_TTL_SECONDS=600
TIKTOK_MARKETING_OAUTH_REQUEST_TIMEOUT_MS=10000
TIKTOK_OUTBOUND_REQUEST_TIMEOUT_MS=10000
